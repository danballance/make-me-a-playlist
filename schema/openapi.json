  "components": {
    "schemas": {
      "ChatMessage": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "agent",
              "user"
            ]
          },
          "content": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "content",
          "role"
        ],
        "title": "ChatMessage"
      },
      "CreateSessionRequest": {
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 1
          }
        },
        "type": "object",
        "required": [
          "topic"
        ],
        "title": "CreateSessionRequest"
      },
      "PlaylistResult": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "result"
          },
          "topic": {
            "type": "string"
          },
          "videos": {
            "items": {
              "$ref": "#/components/schemas/RecommendedVideo"
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 5
          },
          "overall_rationale": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "overall_rationale",
          "topic",
          "videos"
        ],
        "title": "PlaylistResult"
      },
      "RecommendedVideo": {
        "properties": {
          "video_id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "duration_secs": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "view_count": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": "string"
          },
          "what_makes_it_interesting": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "channel",
          "reason",
          "title",
          "url",
          "video_id",
          "what_makes_it_interesting"
        ],
        "title": "RecommendedVideo"
      },
      "ReplyRequest": {
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ReplyRequest"
      },
      "SessionDetailResponse": {
        "properties": {
          "session_id": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array"
          },
          "status": {
            "type": "string",
            "enum": [
              "conversing",
              "searching",
              "complete"
            ]
          },
          "playlist": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PlaylistResult"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "messages",
          "session_id",
          "status",
          "topic"
        ],
        "title": "SessionDetailResponse"
      },
      "SessionResponse": {
        "properties": {
          "session_id": {
            "type": "string"
          },
          "message": {
            "$ref": "#/components/schemas/ChatMessage"
          },
          "status": {
            "type": "string",
            "enum": [
              "conversing",
              "searching",
              "complete"
            ]
          },
          "playlist": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PlaylistResult"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "message",
          "session_id",
          "status"
        ],
        "title": "SessionResponse"
      },
      "TodoItem": {
        "properties": {
          "title": {
            "type": "string"
          },
          "done": {
            "type": "boolean"
          }
        },
        "type": "object",
        "required": [
          "done",
          "title"
        ],
        "title": "TodoItem"
      }
